# 이 파일을 복사해서 .env.local 로 저장하고 값을 채우세요.
#   cp .env.example .env.local
#
# 키가 없어도 앱은 전부 동작합니다 — 다만 숫자가 샘플(목업) 값으로 표시됩니다.
# 화면과 계산 로직은 실제와 같으니, 키만 넣으면 그대로 실데이터로 바뀝니다.

# ─── 네이버 개발자센터 (무료) ─────────────────────────────────
# 쓰이는 곳: 상위노출 분석, 순위 추적, 키워드 발행량, 검색 추이
# 발급: https://developers.naver.com/apps/#/register
#   - 사용 API 에 "검색" + "데이터랩(검색어 트렌드)" 둘 다 체크
#   - 환경은 "WEB 설정", 서비스 URL 은 http://localhost:3000
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 네이버 검색광고 (무료 · 광고 집행 없이도 발급 가능) ───────
# 쓰이는 곳: 키워드 월간 검색량, 경쟁정도
# 발급: https://manage.searchad.naver.com → 우측 상단 "도구" → "API 관리"
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# ─── (선택) 데이터 저장 위치 ──────────────────────────────────
# 기본값은 프로젝트 폴더의 data/ 입니다.
# NAVER_BLOG_DATA_DIR=/path/to/data
